{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "schedule:monthly", ":semanticCommitTypeAll(chore)"],
    "packageRules": [
        { "matchManagers": ["*"], "groupName": "{{{manager}}}" },
        { "matchPackagePatterns": ["^@eejit/"], "minimumReleaseAge": null }
    ],
    "minimumReleaseAge": "1 day",
    "separateMajorMinor": false,
    "rangeStrategy": "bump",
    "timezone": "America/New_York"
}
